rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny for all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // Helper Functions
    // ─────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // Strict Admin Verification:
    // Only verified administrators or the application's authenticated server service account
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "taior.fuli@gmail.com" ||
        request.auth.token.email == "ais-sandbox@ais-europe-west1-fe4503da8f024.iam.gserviceaccount.com" ||
        request.auth.uid == "L7Gzd4KRywahY2xhtqCh7L1eWUH2" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Schema validation for Customer Order Creation
    function isValidOrderCreate() {
      let data = request.resource.data;
      return data.keys().hasAll(['orderNumber', 'customerName', 'phone', 'wilaya', 'address', 'items', 'total', 'status'])
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100
        && data.phone is string && data.phone.size() >= 9 && data.phone.size() <= 20
        && data.wilaya is string && data.wilaya.size() >= 2 && data.wilaya.size() <= 60
        && data.address is string && data.address.size() >= 3 && data.address.size() <= 300
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 100
        && data.total is number && data.total >= 0
        && data.status in ['new', 'confirmed', 'preparing', 'processing', 'shipped', 'completed', 'delivered', 'cancelled', 'returned'];
    }

    // ─────────────────────────────────────────────────────────────
    // 1. Admins Collection (Strictly Locked - Never accessible from client)
    // ─────────────────────────────────────────────────────────────
    match /admins/{adminId} {
      allow read, write: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // 2. Products Collection
    // Public read. Create, update, delete strictly admin and server service account.
    // Untrusted clients cannot modify prices, stock, or variants directly.
    // ─────────────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // 3. Categories Collection
    // Public read only. Create, update, delete strictly admin.
    // ─────────────────────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // 4. Coupons Collection (Marketing & Discount Protection)
    // Direct client access is strictly forbidden.
    // Coupon validation and usage calculations are handled exclusively by the server.
    // ─────────────────────────────────────────────────────────────
    match /coupons/{couponId} {
      allow read, write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // 5. Orders Collection (Customer & Financial Privacy Hardened)
    // Direct client read, list, update, and delete are strictly forbidden for public.
    // Prevents unauthorized visitors from reading order documents or customer PII.
    // Only authenticated admin and server service account have direct access.
    // Safe order tracking is provided via the server /api/orders/track API.
    // ─────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read, write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // 6. Customers Collection (Profile & Identity Protection)
    // Direct client access is strictly forbidden.
    // Customer profile records are managed exclusively by the server transaction.
    // ─────────────────────────────────────────────────────────────
    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // 7. Store Settings
    // Public read for store settings. Sensitive settings strictly forbidden.
    // Write strictly admin.
    // ─────────────────────────────────────────────────────────────
    match /settings/{settingId} {
      allow read: if settingId == 'store';
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // 8. Homepage Content
    // Public read. Write strictly admin.
    // ─────────────────────────────────────────────────────────────
    match /homepage/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // 9. Static Content & Policies
    // Public read. Write strictly admin.
    // ─────────────────────────────────────────────────────────────
    match /content/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // 10. Shipping Rates
    // Public read. Write strictly admin.
    // ─────────────────────────────────────────────────────────────
    match /shipping/{shippingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // 11. Customer Reviews
    // Public read. Validated create. Admin update/delete.
    // ─────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.customer is string
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }
  }
}
